# DeepSeek key used for every typed decision: job rating, form-field mapping, page state.
# Create one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Optional. Default is deepseek-chat. Set to deepseek-reasoner for slower, more deliberate answers.
DEEPSEEK_MODEL=

# Optional. Extra origins the dashboard may be served from, such as a Cloudflare tunnel.
# Comma-separated full origins. Empty keeps it on localhost only.
JEV_REPORT_PUBLIC_ORIGINS=

# Optional. Claude is reached through Claude Code on your subscription by default.
# Put a Claude API key here instead to call the Claude API directly, billed to this key.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional. "claude-code" keeps Claude Code even when the key above is set.
WRITER_BACKEND=

# Optional. The command the writer runs headless. Default is `claude` on your own
# subscription. Set it to a wrapper, such as `deepseek`, to route the writer elsewhere.
# WRITER_COMMAND=
# Optional. The model the writer asks for. Default is claude-sonnet-5-5.
# WRITER_MODEL=

# Only on a machine without the macOS Keychain: the one password your job-board
# accounts use. On a Mac leave this empty and run `npx jev accounts password`,
# which keeps it in the Keychain.
JEV_ACCOUNTS_PASSWORD=
